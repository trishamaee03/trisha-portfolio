    <!-- JAVASCRIPT -->
    <script>
      // Navigation Glassmorphism
      const nav = document.getElementById("nav");
      window.addEventListener("scroll", () => {
        if (window.scrollY > 40) nav.classList.add("scrolled");
        else nav.classList.remove("scrolled");
      });

      // Mobile Menu Toggle
      function toggleMobileMenu() {
        const el = document.getElementById("mobileMenu");
        el.style.display = (el.style.display === "flex") ? "none" : "flex";
      }
      document.getElementById("mobileBtn").addEventListener("click", toggleMobileMenu);

      // Smooth Scroll
      function scrollToSec(selector) {
        const target = document.querySelector(selector);
        if (target) target.scrollIntoView({ behavior: "smooth", block: "start" });
      }

      // Iframe Modal
      const modalWrap = document.getElementById("iframeModal");
      const modalIframe = document.getElementById("modalIframe");
      const modalIframeTitle = document.getElementById("modalIframeTitle");

      function openIframeModal(title, src) {
        modalIframeTitle.textContent = title;
        modalIframe.src = src;
        modalWrap.style.display = "flex";
      }

      function closeIframeModal() {
        modalWrap.style.display = "none";
        modalIframe.src = "";
      }

      // Escape Key Handler
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          closeIframeModal();
          document.getElementById("mobileMenu").style.display = "none";
          document.getElementById("calChatWindow").style.display = "none";
        }
      });

      // --- CAL AI CHATBOT WITH STRICT SCOPE FILTER ---
      let hasGreeted = false;

      function toggleCalChat() {
        const chatWin = document.getElementById("calChatWindow");
        const isHidden = getComputedStyle(chatWin).display === "none";
        
        if (isHidden) {
          chatWin.style.display = "flex";
          if (!hasGreeted) {
            appendBotMsg("Hi there! I'm Cal, Trisha's AI assistant. 👋 Ask me anything about Trisha's skills, projects, background, or contact details!");
            hasGreeted = true;
          }
        } else {
          chatWin.style.display = "none";
        }
      }

      function appendBotMsg(text) {
        const chatBody = document.getElementById("chatBody");
        const msgDiv = document.createElement("div");
        msgDiv.className = "chat-msg bot";
        msgDiv.innerText = text;
        chatBody.appendChild(msgDiv);
        chatBody.scrollTop = chatBody.scrollHeight;
      }

      function appendUserMsg(text) {
        const chatBody = document.getElementById("chatBody");
        const msgDiv = document.createElement("div");
        msgDiv.className = "chat-msg user";
        msgDiv.innerText = text;
        chatBody.appendChild(msgDiv);
        chatBody.scrollTop = chatBody.scrollHeight;
      }

      function sendQuickMsg(text) {
        appendUserMsg(text);
        processAiResponse(text);
      }

      function handleSendChat() {
        const input = document.getElementById("chatInput");
        const text = input.value.trim();
        if (!text) return;
        appendUserMsg(text);
        input.value = "";
        processAiResponse(text);
      }

      // Stop words to prevent false positive matching on question words
      const STOP_WORDS = new Set([
        'a', 'about', 'am', 'an', 'and', 'are', 'as', 'at', 'be', 'by', 'came', 'can', 
        'did', 'do', 'does', 'for', 'from', 'get', 'give', 'has', 'have', 'he', 'hello', 
        'her', 'here', 'hey', 'hi', 'him', 'his', 'how', 'i', 'in', 'is', 'it', 'its', 
        'me', 'my', 'of', 'on', 'or', 'she', 'show', 'tell', 'the', 'their', 'them', 
        'then', 'there', 'these', 'they', 'this', 'tirhsa', 'to', 'trisha', 'trishas', 
        'was', 'what', 'when', 'where', 'which', 'who', 'why', 'will', 'with', 'would', 'you'
      ]);

      // Categorized portfolio keywords
      const CATEGORY_KEYWORDS = {
        skills: ['skill', 'skills', 'skil', 'skils', 'language', 'languages', 'java', 'cpp', 'csharp', 'html', 'css', 'coding', 'code', 'stack', 'tech', 'algorithm', 'algorithms'],
        projects: ['project', 'projects', 'projct', 'projcts', 'work', 'works', 'demo', 'portfolio', 'registration', 'multiplication', 'form', 'table'],
        achievements: ['achievement', 'achievements', 'achivement', 'award', 'awards', 'milestone', 'milestones', 'certificate', 'certificates', 'pcu'],
        about: ['background', 'bio', 'student', 'degree', 'education', 'school', 'university', 'college', 'experience'],
        contact: ['contact', 'email', 'mail', 'reach', 'social', 'github', 'linkedin', 'twitter', 'message', 'hire', 'phone'],
        greeting: ['hello', 'hi', 'hey', 'greetings', 'sup', 'cal', 'help']
      };

      function levenshtein(a, b) {
        const m = a.length, n = b.length;
        const dp = Array.from({ length: m + 1 }, () => new Array(n + 1).fill(0));
        for (let i = 0; i <= m; i++) dp[i][0] = i;
        for (let j = 0; j <= n; j++) dp[0][j] = j;
        for (let i = 1; i <= m; i++) {
          for (let j = 1; j <= n; j++) {
            if (a[i - 1] === b[j - 1]) dp[i][j] = dp[i - 1][j - 1];
            else dp[i][j] = 1 + Math.min(dp[i - 1][j], dp[i][j - 1], dp[i - 1][j - 1]);
          }
        }
        return dp[m][n];
      }

      function tokenMatchesKeyword(token, keyword) {
        if (token === keyword) return true;
        if (token.length >= 4 && keyword.length >= 4) {
          if (token.includes(keyword) || keyword.includes(token)) return true;
          const dist = levenshtein(token, keyword);
          if (dist <= 1) return true;
        }
        return false;
      }

      function checkCategoryMatch(tokens, categoryList) {
        return tokens.some(token => 
          categoryList.some(keyword => tokenMatchesKeyword(token, keyword))
        );
      }

      function processAiResponse(userInput) {
        const cleanInput = userInput.toLowerCase().replace(/[^a-z0-9\s]/g, '');
        const allTokens = cleanInput.split(/\s+/).filter(Boolean);
        
        // Filter out common English stop words
        const meaningfulTokens = allTokens.filter(token => !STOP_WORDS.has(token));

        const isSkills = checkCategoryMatch(meaningfulTokens, CATEGORY_KEYWORDS.skills);
        const isProjects = checkCategoryMatch(meaningfulTokens, CATEGORY_KEYWORDS.projects);
        const isAchievements = checkCategoryMatch(meaningfulTokens, CATEGORY_KEYWORDS.achievements);
        const isAbout = checkCategoryMatch(meaningfulTokens, CATEGORY_KEYWORDS.about);
        const isContact = checkCategoryMatch(meaningfulTokens, CATEGORY_KEYWORDS.contact);
        const isGreeting = checkCategoryMatch(allTokens, CATEGORY_KEYWORDS.greeting);

        setTimeout(() => {
          if (isSkills) {
            appendBotMsg("Trisha has strong foundations in Java, C++, C#, HTML & CSS, along with problem-solving and basic algorithmic thinking!");
          } else if (isProjects) {
            appendBotMsg("Trisha has featured projects:\n1) Student Registration Form (HTML/CSS)\n2) Basic Multiplication Table\n\nYou can click them in the Work section to preview them live!");
          } else if (isAchievements) {
            appendBotMsg("Her key achievements include academic progress as an IT student at PCU, mastering multi-language OOP modules, and building functional web applications!");
          } else if (isAbout) {
            appendBotMsg("Trisha is an enthusiastic IT student at Philippine Christian University dedicated to learning step-by-step and building solid software development skills!");
          } else if (isContact) {
            appendBotMsg("You can reach Trisha directly via email at trisha.enore.coi@pcu.edu.ph.com or connect via her GitHub and LinkedIn links!");
          } else if (isGreeting && meaningfulTokens.length === 0) {
            appendBotMsg("Hello! How can I assist you with Trisha's portfolio today?");
          } else {
            // OUT OF SCOPE / UNHANDLED QUESTION FALLBACK
            appendBotMsg("I'm sorry, I don't have information about that! I am specifically programmed to answer questions regarding Trisha's portfolio, skills, projects, achievements, and contact details. 🤖\n\nFeel free to ask me about her technical background or featured work!");
          }
        }, 300);
      }
    </script>
